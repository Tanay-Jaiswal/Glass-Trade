# Copy this file to .env and fill in your Glimpse API key.
# Never commit .env to version control.

# Your Glimpse API key from Settings → API Keys
# The key IS the JWT — no separate auth exchange needed.
GLIMPSE_API_KEY=your_api_key_here

# Optional: override the base URL (default: https://main.bpmapi.io)
# GLIMPSE_BASE_URL=https://main.bpmapi.io

# SQLite database file path (relative to backend/)
DB_PATH=glass.db

# How many pages of resolved markets to fetch per batch (50 markets/page).
# Set to 0 to fetch all (may be slow on first run).
MAX_RESOLVED_PAGES=20
